# Estação local da nutrição: copie para .env.local (mesma pasta) e preencha.
#   cp .env.example .env.local
# O .env.local NUNCA vai para o git. Variáveis do ambiente ganham deste arquivo.

# Chave da API da Anthropic. Antes de atender pessoas reais, use uma chave de
# uma organização separada da Anthropic com retenção zero de dados (ZDR).
# Sem chave, a estação liga normalmente e só o "organizar com IA" fica desligado.
ANTHROPIC_API_KEY=

# Modelo da IA (padrão: claude-opus-5).
# MODELO_IA=claude-opus-5

# Porta local (padrão: 8787). A estação escuta sempre em 127.0.0.1; HOST é ignorado.
# PORTA=8787

# Origens do app que podem falar com a estação, separadas por vírgula.
# Padrão: http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5173,http://localhost:5173
# Para o app publicado, acrescente o endereço dele (ex.: https://app.exemplo.com.br).
# ORIGENS_PERMITIDAS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5173,http://localhost:5173

# Pasta dos dados da estação (áudios, transcrições, modelo).
# Padrão: ~/Library/Application Support/EstacaoNutri
# PASTA_DADOS=~/Library/Application Support/EstacaoNutri

# Modelo do whisper.cpp. Padrão: <PASTA_DADOS>/modelos/ggml-large-v3-turbo-q5_0.bin
# (se não existir, a estação usa um ggml-small.bin, quando houver).
# MODELO_WHISPER=~/Library/Application Support/EstacaoNutri/modelos/ggml-large-v3-turbo-q5_0.bin

# Programas (padrão: Homebrew no Mac com Apple Silicon).
# WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg

# Por quantos dias os áudios (e transcrições) ficam no Mac (padrão: 7).
# DIAS_RETENCAO_AUDIO=7
